<?xml version="1.0" encoding="UTF-8"?>
<project name="MJCompiler" default="compile" basedir=".">

	<!-- Brisanje svih fajlova iz direktorijuma navedenih u fileset-u, izuzev fajlova oznacenih sa exclude -->
	<target name="delete">
		<delete>
			<fileset dir="src/rs/ac/bg/etf/pp1">
				<exclude name="util/Log4JUtils.java"/>
				<exclude name="SemAnalyzer.java"/>
				<exclude name = "CodeGenerator.java"/>
			</fileset>
		</delete>
		<delete>
			<fileset dir="spec">
				<exclude name="mjlexer.lex"/>
				<exclude name="mjparser.cup"/>
			</fileset>
		</delete>
	</target>

	<!-- Generisanje Yylex.java klase (lexer klasa), iz fajla mjlexer.lex, pomocu alata JFlex -->
	<!-- Ako dodje do izmene lexer.lex fajla, mora opet da se pokrene lexerGen -->
	<!-- Ponovno pokretanje lexerGen-a ce obrisati vecinu fajlova iz src foldera, pa je potrebno opet pozvati parserGen i compile -->
	<target name="lexerGen" depends="delete">
		<java jar="lib/JFlex.jar" fork="true">
			<arg value="-d"/>
			<arg value="./src/rs/ac/bg/etf/pp1"/>
			<arg value="spec/mjlexer.lex"/>
		</java>
	</target>
	
	<!-- Generisanje sym.java klase, iz fajla mjparser.cup, pomocu alata cup_v10k -->
	<!-- Ako dodje do izmene mjparser.cup fajla, mora opet da se pokrene parserGen -->
	<!-- Ponovno pokretanje parserGen-a ce izmeniti dosta fajlova iz src foldera, pa je potrebno opet pozvati compile, zbog promena paketa -->
	<target name="parserGen" depends="lexerGen">
		<java jar="lib/cup_v10k.jar" fork="true">
			<arg value="-destdir"/>
			<arg value="src/rs/ac/bg/etf/pp1"/>
			<arg value="-ast"/>
			<arg value="src.rs.ac.bg.etf.pp1.ast"/>
			<arg value="-parser"/>
			<arg value="MJParser"/>
			<arg value="-dump_states"/>
			<arg value="-buildtree"/>
			<arg value="spec/mjparser.cup"/>
		</java>
	</target>

	<!-- Menjanje naziva paketa "src.rs.ac.bg.etf.pp1.ast" u "rs.ac.bg.etf.pp1.ast", u svim fajlovima src foldera -->
	<target name="repackage" depends="parserGen">
		<replace dir="src" value="rs.ac.bg.etf.pp1.ast" token="src.rs.ac.bg.etf.pp1.ast" summary="true"/>
	</target>

	<!-- Kompajliranje java fajlova na putanji "src/rs/ac/bg/etf/pp1", mora da se pozove pre pokretanja Compiler.java fajla -->
	<!-- Navedene su sve biblioteke koje koriste targeti koji se pozivaju pre compile -->
	<target name="compile" depends="repackage">
		<javac srcdir="src/rs/ac/bg/etf/pp1" includeantruntime="false">
			<classpath>
				<pathelement path="lib/JFlex.jar"/>
				<pathelement path="lib/cup_v10k.jar"/>
				<pathelement path="lib/log4j-1.2.17.jar"/>
				<pathelement path="lib/symboltable-1-1.jar"/>
				<pathelement path="lib/mj-runtime-1.1.jar"/>
			</classpath>
		</javac>

	</target>
	<target name="disasm">
			<java classname="rs.etf.pp1.mj.runtime.disasm">
				<arg value="test/program.obj"/>
				<classpath>
					<pathelement location="lib/mj-runtime-1.1.jar"/>
				</classpath>
			</java>
		</target>

		<target name="runObj" depends="disasm">
			<java classname="rs.etf.pp1.mj.runtime.Run" input="test/input.txt">
				<arg value="test/program.obj"/>
				<classpath>
					<pathelement location="lib/mj-runtime-1.1.jar"/>
				</classpath>
			</java>
		</target>
	
		<target name="debugObj" depends="disasm">
			<java classname="rs.etf.pp1.mj.runtime.Run" input="test/input.txt">
				<arg value="test/program.obj"/>
				<arg value="-debug"/>
				<classpath>
					<pathelement location="lib/mj-runtime-1.1.jar"/>
				</classpath>
			</java>
		</target>

</project>
